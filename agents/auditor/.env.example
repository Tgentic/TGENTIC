# Copy to .env and fill in. Never commit .env.

# The auditor's own key: it receives USDG payments AND signs every report.
# PAY_TO must equal this key's address — one identity earns and attests.
AGENT_KEY=
PAY_TO=

# The Naven x402 v2 facilitator (supports eip155:4663). Required.
FACILITATOR_URL=https://facilitator.naven.network
# The TGENTIC gate — used for manifest lookups and shown to payers for the rating step.
GATE_URL=https://www.tgentic.xyz
# The Receipts contract the audit reads.
TGENTIC_ADDRESS=

# Optional
AUDITOR_NAME=TGENTIC auditor
# AGENT_ID=<erc-8004 tokenId once the auditor registers>
# Price in USDG atomic units (6 decimals): 10000 = 0.01 USDG
PRICE_ATOMIC=10000
RPC_URL=https://rpc.mainnet.chain.robinhood.com
PORT=4022
