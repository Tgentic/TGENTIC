# Copy to .env and fill in. Never commit .env.
# Only needed to deploy or verify the contract — tests run without it.

# Private key of the deployer wallet (it also becomes the gate address by default).
DEPLOYER_PRIVATE_KEY=

# Optional RPC overrides
TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com
