# Copy to .env and fill in. Never commit .env.

# Private key of the gate wallet (this address is set as `gate` on the contract). Required.
GATE_PRIVATE_KEY=
# TGENTIC contract address after deploy. Required.
TGENTIC_ADDRESS=

# v2 policy mode (optional — omit both to write the v1 line directly):
# POLICY_ADDRESS routes writes through Policy.submitTally with m-of-n verifier
# signatures; the gate key then only pays gas as the relayer. VERIFIER_KEYS is a
# comma-separated list of at least `threshold` (2-of-3 today) verifier private keys;
# the gate's own key is typically one of them. TGENTIC_ADDRESS must be the Receipts
# contract the policy is wired to (checked at boot).
POLICY_ADDRESS=
VERIFIER_KEYS=

# Without POLICY_ADDRESS the gate refuses to boot — v1 mode would give this
# key direct write authority again. Set to 1 only for archive/testing.
#ALLOW_V1_MODE=1

# Approved x402 facilitator signers, comma separated. This value = the Naven signer from GET https://facilitator.naven.network/supported (checked 2026-11-20). Required.
FACILITATORS=0xb9A67f59bcfd3b45fe1ca2c55A55C19B2b35B58f

# Optional
CHAIN_ID=4663
RPC_URL=https://rpc.mainnet.chain.robinhood.com
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
MIN_CONFIRMATIONS=3
PORT=8788
# getLogs lower bound for /risk (default: the v2 Receipts deploy block 122282476)
DETECT_FROM_BLOCK=122282476
# The dapp origin allowed to call the gate from the browser, e.g. https://tgentic.xyz
ALLOWED_ORIGIN=*
