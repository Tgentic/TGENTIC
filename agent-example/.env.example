# Copy to .env and fill in. Never commit .env.

# The agent wallet that receives USDG payments. Required.
PAY_TO=
# The Naven x402 v2 facilitator, supports eip155:4663 and testnet eip155:46630 (checked 2026-11-20). Required.
FACILITATOR_URL=https://facilitator.naven.network

# Optional
# Price in USDG atomic units (6 decimals): 10000 = 0.01 USDG
PRICE_ATOMIC=10000
# The TGENTIC gate, shown to the payer after payment
GATE_URL=http://localhost:8788
PORT=4021
